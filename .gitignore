# Local development history and original design references
/IMPLEMENTATION_PLAN.md
/IMPLEMENTATION_STATUS.md
/DESIGN_IMPLEMENTATION.md
/VALIDATION.md
/design guidelines/

# Books and archives stay local, including uppercase extensions
*.[cC][bB][zZ]
*.[cC][bB][rR]
*.[rR][aA][rR]
*.[pP][dD][fF]
*.[zZ][iI][pP]
*.[cC][bB]7
*.7[zZ]
*.[eE][pP][uU][bB]

# Original generated test fixtures are required for a clean checkout
!/app/src/androidTest/assets/fixtures/*.cbz
!/app/src/androidTest/assets/fixtures/*.cbr
!/app/src/androidTest/assets/fixtures/*.rar
!/app/src/androidTest/assets/fixtures/*.pdf
!/app/src/androidTest/assets/fixtures/*.cb7
!/app/src/androidTest/assets/fixtures/*.7z
